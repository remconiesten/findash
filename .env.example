MARIADB_HOST=192.168.1.10
MARIADB_PORT=3306
MARIADB_USER=findash
MARIADB_PASSWORD=
MARIADB_DATABASE=findash
# Transacties: schema MARIADB_DATABASE (kopie in findash). n8n blijft
# historisch/Raw. Vertalingen: FINDASH_DATABASE op dezelfde server.
# Geen tweede wachtwoord. ALL op findash; SELECT op n8n tot n8n uit is.
FINDASH_DATABASE=findash
FINDASH_HOST=127.0.0.1
FINDASH_PORT=8088
FINDASH_DEFAULT_LOCALE=nl
QDRANT_URL=http://192.168.1.10:6333
QDRANT_API_KEY=
FINDASH_QDRANT_COLLECTION=findash_tx
FINDASH_QDRANT_AUTO=0
FINDASH_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FINDASH_EMBED_CACHE=.cache/fastembed
# Add-on (HA) sets these; laptop can leave them empty.
# FINDASH_ANONYMIZE=/share/findash/anonymize.local.json
# FINDASH_STAGE_DIR=/data/import
# Account labels as stored in MariaDB (household-specific; keep real names in .env only).
FINDASH_CC_REKENING=Rekening A
FINDASH_OWN_REKENINGEN=Rekening A,Rekening B
